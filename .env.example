# Lightning backend (LNbits instance). Server-side only — never exposed to the bundle.
LNBITS_URL=https://your-lnbits-instance.example
LNBITS_INVOICE_KEY=your_invoice_read_key

# Creator profile (public, safe in the bundle)
VITE_CREATOR_NAME=Your Name
VITE_CREATOR_HANDLE=@yourhandle
VITE_CREATOR_BLURB=Support my work with a Lightning tip
VITE_CREATOR_AVATAR_URL=

# Tip presets in sats, comma-separated, cheapest first
VITE_TIP_PRESETS_SATS=1000,5000,21000

# Custom amount and message bounds shown in the page (defaults: smallest preset, 100000, 140)
VITE_TIP_MIN_SATS=1000
VITE_TIP_MAX_SATS=100000
VITE_TIP_MESSAGE_MAX_CHARS=140

# Server-side copies of the same bounds; these are the ones enforced
TIP_MIN_SATS=1000
TIP_MAX_SATS=100000
TIP_MESSAGE_MAX_CHARS=140

# Fiat estimate: currency when Nimiq Pay reports none, and the BTC rates source
VITE_FALLBACK_FIAT=USD
PRICE_API_URL=https://api.coinbase.com/v2/exchange-rates?currency=BTC

# Optional: Nimiq address for an on-chain public tip memo (64-byte data field)
VITE_TIP_MEMO_RECIPIENT=

# Dev only: mock the Lightning backend so the UI can be exercised
# without LNbits and without spending real money.
VITE_MOCK_BACKEND=false

# Seconds to wait on the Nimiq Pay payment sheet before offering a status check
VITE_WALLET_STALL_SECONDS=60
